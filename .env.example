# server
PORT=3000

# JWT secret used to sign the operator login tokens
JWT_SECRET=change_me_super_secret

# CORS - the CPA frontend origin (so it can call this API from the browser)
FRONTEND_ORIGIN=http://localhost:5173

# Experiment API (provided by David) - this server proxies requests to it.
# Fill these in once you have the real values, nothing else needs to change.
EXPERIMENT_API_BASE_URL=https://example-experiment-api.invalid
EXPERIMENT_API_KEY=replace_with_real_key

# where the file-based storage layer writes its data
DATA_FILE_PATH=./data/store.json
